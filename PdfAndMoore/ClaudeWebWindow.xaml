<Window x:Class="PdfAndMoore.ClaudeWebWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Claude - PDF and Moore"
        Icon="Assets/app.ico"
        Width="560" Height="860" MinWidth="380" MinHeight="400"
        Background="#FAF9F5">
    <DockPanel>
        <!-- Small toolbar above claude.ai -->
        <Border DockPanel.Dock="Top" Background="#F0EEE6" BorderBrush="#E0DDD3" BorderThickness="0,0,0,1" Padding="8,6">
            <DockPanel LastChildFill="True">
                <Button x:Name="BackButton" Content="‹ Back" Click="OnBack" Padding="10,3" Margin="0,0,6,0" Background="Transparent" BorderBrush="#CFCBBF" />
                <Button x:Name="NewChatButton" Content="New chat" Click="OnNewChat" Padding="10,3" Margin="0,0,6,0" Background="Transparent" BorderBrush="#CFCBBF" />
                <Button x:Name="BrowserButton" DockPanel.Dock="Right" Content="Open in my browser" Click="OnOpenInBrowser" Padding="10,3" Background="Transparent" BorderBrush="#CFCBBF"
                        ToolTip="If signing in with Google doesn't work here, use your normal web browser instead." />
                <TextBlock x:Name="HintText" VerticalAlignment="Center" Margin="6,0" Foreground="#5F5B52" FontSize="12" TextTrimming="CharacterEllipsis"
                           Text="Sign in with your Claude account. Press Ctrl+V to paste what you sent." />
            </DockPanel>
        </Border>
        <!-- The real claude.ai website. Your sign-in stays on this computer. -->
        <wv2:WebView2 x:Name="Web" />
    </DockPanel>
</Window>
