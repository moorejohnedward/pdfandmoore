<Window x:Class="PdfAndMoore.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="PDF and Moore"
        Icon="Assets/app.ico"
        Width="1440" Height="900"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#F9FBFD">
    <Grid>
        <!-- The editor (menus, toolbar, pages, Claude panel) is a web page shown by Edge WebView2. -->
        <wv2:WebView2 x:Name="Web" Visibility="Hidden" />

        <!-- A hidden second WebView2 that turns Word/Excel/HTML into PDF pages. -->
        <wv2:WebView2 x:Name="PrintView" Visibility="Hidden" Width="816" Height="1056"
                      HorizontalAlignment="Left" VerticalAlignment="Top" />

        <!-- Shown until the editor has loaded. -->
        <StackPanel x:Name="Splash" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image Source="Assets/app.png" Width="72" Height="72" Margin="0,0,0,12" />
            <TextBlock Text="PDF and Moore" FontSize="22" FontFamily="Segoe UI" HorizontalAlignment="Center" Foreground="#1F1F1F" />
            <TextBlock x:Name="SplashStatus" Text="Starting…" FontSize="13" FontFamily="Segoe UI" HorizontalAlignment="Center" Foreground="#5F6368" Margin="0,6,0,0" />
        </StackPanel>
    </Grid>
</Window>
