<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PdfAndMoore</RootNamespace>
    <AssemblyName>PdfAndMoore</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>PDF and Moore</Product>
    <Company>Moore</Company>
    <Description>PDF editor with Google Docs-style controls and Claude as an AI assistant.</Description>
    <Version>8.1.0</Version>
    <!-- Lets "dotnet publish" make a single folder you can copy to another PC. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft Edge WebView2: hosts the editor UI (PDF rendering, OCR, Claude panel). -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
    <!-- Encrypts your Claude API key for your Windows user account. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The editor's web files are copied next to the .exe. -->
    <Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app.png" />
  </ItemGroup>

</Project>
